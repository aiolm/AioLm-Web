# Copy to .env.local for local development. Never commit real credentials.
# Production values are configured in the hosting provider (Vercel) and the
# managed database provider (Supabase). Placeholders only here.
#
# `npm run config:check` validates a real environment against the production
# rules without printing any configured secret value. See docs/deployment.md.

# ---------------------------------------------------------------------------
# Web runtime (the Vercel project env). Only what an anonymous request handler
# needs, with the least-privilege runtime database role and nothing else.
# ---------------------------------------------------------------------------

# Postgres connection string for the aiolm_web_runtime login. Local synthetic
# tests use an isolated database; production uses the Supabase pooler URL
# (transaction mode, port 6543). TLS is verified against every remote server;
# only a non-production loopback target connects without it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiolm_web
# Optional: pin a private CA instead of the platform trust store.
DATABASE_CA_CERT=

# HMAC secrets (32+ random bytes, base64url). Generate per environment, and use
# three different values. Used for upload permits, management session signing,
# and IP quota key hashing.
PERMIT_HMAC_SECRET=
MANAGEMENT_HMAC_SECRET=
QUOTA_HMAC_SECRET=

# Cloudflare Turnstile keys. Publishable site key may be public; secret stays
# server-only. Cloudflare's testing keys always pass or always fail and are
# rejected by config:check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Expected hostname (must equal SERVICE_ORIGIN's host) and actions, verified
# server-side via siteverify. The two action names are compiled into the browser
# widget: a different value here makes every token fail with action-mismatch.
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_VERIFY_ACTION=benchmark_publish
TURNSTILE_REPORT_ACTION=benchmark_report

# Public service origin, e.g. https://benchmarks.example.com. Used for recovery
# code origin binding, verification_url construction, and the exact Origin match
# on management mutations. HTTPS is required in production.
SERVICE_ORIGIN=http://localhost:3000

# Quota/budget overrides (defaults match the shared spec). A value that is not a
# positive integer is ignored in favour of the default.
QUOTA_PER_IP_HOUR=20
QUOTA_PER_IP_DAY=100
QUOTA_GLOBAL_DAY=1000
QUOTA_GLOBAL_BYTES_DAY=67108864
QUOTA_GLOBAL_ROWS_DAY=250000
QUOTA_SESSION_CREATE_PER_MIN_IP=5
QUOTA_INVALID_MANAGE_PER_MIN_IP=10
QUOTA_REPORT_PER_HOUR_IP=3

# Capacity guard: provisioned DB capacity reporting. When used bytes/rows exceed
# these fractions of the provisioned totals, new publishing alerts/stops.
# Operators set these from the database provider dashboard. REQUIRED in
# production: with neither set, every new publish returns 503.
PROVISIONED_BYTES=
PROVISIONED_ROWS=

# ---------------------------------------------------------------------------
# Operator shell only (a workstation or CI). NEVER set these in the web runtime:
# the public function never runs DDL and never moderates, and config:check fails
# when it finds them there.
# ---------------------------------------------------------------------------

# Migration-owner and moderation-role URLs, used by db:migrate, moderate, and
# the pg_cron retention setup script. Required in production; local/test
# environments fall back to DATABASE_URL.
DATABASE_MIGRATION_URL=
DATABASE_MODERATION_URL=

# ---------------------------------------------------------------------------
# Test environment only. NEVER set in a deployment.
# ---------------------------------------------------------------------------

# Synthetic test mode. When "1" and NODE_ENV=test, Turnstile verification and
# the client-IP adapter accept explicit test fixtures.
SYNTHETIC_TEST_MODE=
TEST_FIXTURE_TURNSTILE_TOKEN=test-turnstile-ok
