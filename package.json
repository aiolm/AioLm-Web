{
  "name": "aiolm-web",
  "version": "1.1.0",
  "description": "AioLM product website and anonymous benchmark explorer (Next.js + PostgreSQL + Turnstile). No accounts in v1.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "prune": "tsx scripts/prune.ts",
    "moderate": "tsx scripts/moderate.ts",
    "contracts:check": "tsx scripts/contracts-check.ts",
    "config:check": "tsx scripts/config-check.ts"
  },
  "keywords": [],
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aiolm/benchmark-contracts": "file:vendor/aiolm-benchmark-contracts-0.5.1.tgz",
    "next": "^15.5.25",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
